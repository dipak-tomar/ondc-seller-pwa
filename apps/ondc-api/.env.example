# ONDC Seller API Environment Variables
# Copy this file to .env and update with your actual values

# Security - REQUIRED: Change in production
SECRET_KEY=your-secret-key-change-in-production

# Database - REQUIRED: Update for production
DATABASE_URL=postgresql+psycopg://ondc:ondc_dev_password@localhost:5432/ondc_seller

# Redis - REQUIRED: Update for production
REDIS_URL=redis://localhost:6379/0

# S3/MinIO - REQUIRED: Update for production
# For local development, use MinIO defaults
# For production, use AWS S3 or Cloudflare R2 credentials
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=ondc-products
S3_REGION=us-east-1

# Twilio - Optional: For WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Postmark - Optional: For email notifications
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=noreply@ondcseller.com

# Razorpay - Optional: For payment processing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ONDC - Optional: For ONDC integration
ONDC_SELLER_APP_URL=
ONDC_SELLER_APP_KEY=

# Sentry - Optional: For error tracking
SENTRY_DSN=

# Telemetry - Optional
ENABLE_TELEMETRY=false
